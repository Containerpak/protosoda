{
  "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v2.json",
  "manifest_version": "2.0",
  "name": "ProtoSoda",
  "description": "Use Soda in the Proton layout expected by Steam and UMU.",
  "version": "11.0-1",
  "image": "ghcr.io/containerpak/protosoda:main",
  "binaries": [
    "/usr/bin/protosoda"
  ],
  "dependencies": [],
  "addons": [],
  "idle_time": 0,
  "override": {
    "socketX11": false,
    "socketWayland": false,
    "socketPulseAudio": false,
    "socketSessionBus": false,
    "socketSystemBus": false,
    "socketSshAgent": false,
    "socketCups": false,
    "socketGpgAgent": false,
    "socketAtSpiBus": false,
    "socketBluetooth": false,
    "deviceDri": false,
    "deviceKvm": false,
    "deviceShm": false,
    "deviceAlsa": false,
    "deviceVideo": false,
    "deviceFuse": false,
    "deviceTun": false,
    "deviceUsb": false,
    "deviceAll": false,
    "notification": false,
    "openURI": false,
    "filesystem": [],
    "env": [],
    "network": false,
    "process": false,
    "userNamespaces": false,
    "memoryMaxMB": 0,
    "cpuQuota": 0,
    "pidsMax": 0,
    "asRoot": false,
    "allowedHostCommands": []
  }
}
